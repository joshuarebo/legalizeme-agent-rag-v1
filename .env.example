# ===========================================
# LegalizeMe AI Agent - Environment Variables
# ===========================================

# AWS Configuration (Required for Production)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_SESSION_TOKEN=  # Optional, for temporary credentials

# API Keys (Optional - for enhanced model access)
HUGGINGFACE_API_KEY=your_huggingface_api_key
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Application Configuration
DEBUG_MODE=true
ENVIRONMENT=development  # development, staging, production
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
PORT=8000

# AI Model Configuration
PRIMARY_LLM_TYPE=claude-4  # claude-4, hunyuan-a13b, flan-t5, mixtral, llama
FALLBACK_LLM_TYPE=flan-t5
MODEL_CACHE_DIR=./data/model_cache
ENABLE_MODEL_QUANTIZATION=true

# Database Configuration
VECTOR_DB_PATH=./data/vector_db
FAISS_INDEX_PATH=./data/faiss_index
ENABLE_VECTOR_CACHE=true

# Crawler Configuration
ENABLE_CRAWLER=true
CRAWLER_INTERVAL_HOURS=24
CRAWLER_MAX_PAGES=1000
CRAWLER_RATE_LIMIT=2  # requests per second

# Performance Configuration
ENABLE_PERFORMANCE_OPTIMIZER=true
MAX_CONCURRENT_REQUESTS=10
RESPONSE_TIMEOUT_SECONDS=30
ENABLE_RESPONSE_CACHING=true
CACHE_TTL_SECONDS=3600

# Security Configuration
CORS_ORIGINS=["http://localhost:3000", "https://yourdomain.com"]
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MINUTES=1

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_EXPORT_INTERVAL=60
HEALTH_CHECK_INTERVAL=30

# Document Processing Configuration
MAX_DOCUMENT_SIZE_MB=50
ALLOWED_DOCUMENT_TYPES=["pdf", "docx", "txt", "html"]
DOCUMENT_PROCESSING_TIMEOUT=300

# Legal Data Sources
KENYA_LAW_BASE_URL=https://new.kenyalaw.org/
ENABLE_AUTO_INDEXING=true
INDEX_UPDATE_INTERVAL_HOURS=6

# Development Configuration
DEV_MOCK_RESPONSES=false
DEV_SKIP_MODEL_LOADING=false
DEV_ENABLE_SQL_LOGGING=false

# Test Configuration
TEST_MODE=false
TEST_DATA_PATH=./tests/data
TEST_SKIP_SLOW_TESTS=false