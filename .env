# API Settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG_MODE=True

# Vector DB Settings
VECTOR_DB_TYPE=faiss  # Options: faiss, weaviate
WEAVIATE_URL=http://localhost:8080
VECTOR_DB_PATH=./data/vector_db

# LLM Settings
PRIMARY_LLM_TYPE=mixtral  # Options: mixtral, llama3
FALLBACK_LLM_TYPE=minimax
MODEL_CACHE_DIR=./data/model_cache

# Document Processing
PDF_TEMP_DIR=./data/temp_pdfs
MAX_DOCUMENT_SIZE_MB=10

# Redis Settings (for memory persistence)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Kenya Law API Settings (if available)
KENYA_LAW_API_URL=https://new.kenyalaw.org/api
KENYA_LAW_API_KEY=

# Crawler Settings
ENABLE_CRAWLER=True
CRAWLER_DAILY_UPDATE_TIME=02:00  # 2 AM
CRAWLER_QUICK_UPDATE_HOURS=6  # Every 6 hours
CRAWLER_MAX_PAGES=5  # Max pages per section

# Performance Optimization Settings
ENABLE_OPTIMIZATION=True
AUTO_OPTIMIZE=True
OPTIMIZATION_INTERVAL_HOURS=24
OPTIMIZATION_TIME=03:00  # 3 AM

# FAISS Optimization Parameters
FAISS_USE_HNSW=True
FAISS_M_HNSW=32
FAISS_EF_CONSTRUCTION=200
FAISS_NLIST=100
FAISS_NPROBE=10
FAISS_QUANTIZE=True

# LLM Optimization Parameters
# Mixtral
MIXTRAL_TEMPERATURE=0.3
MIXTRAL_TOP_P=0.95
MIXTRAL_REPETITION_PENALTY=1.15
MIXTRAL_MAX_NEW_TOKENS=1024
MIXTRAL_BATCH_SIZE=1
MIXTRAL_USE_FLASH_ATTENTION=True
MIXTRAL_USE_4BIT=True
MIXTRAL_USE_CACHE=True
MIXTRAL_USE_KV_CACHE=True

# LLaMA 3
LLAMA3_TEMPERATURE=0.3
LLAMA3_TOP_P=0.95
LLAMA3_REPETITION_PENALTY=1.15
LLAMA3_MAX_NEW_TOKENS=1024
LLAMA3_BATCH_SIZE=1
LLAMA3_USE_FLASH_ATTENTION=True
LLAMA3_USE_4BIT=True
LLAMA3_USE_CACHE=True
LLAMA3_USE_KV_CACHE=True

# MiniMax
MINIMAX_TEMPERATURE=0.3
MINIMAX_TOP_P=0.95
MINIMAX_REPETITION_PENALTY=1.15
MINIMAX_MAX_NEW_TOKENS=1024
MINIMAX_BATCH_SIZE=1
MINIMAX_USE_FLASH_ATTENTION=True
MINIMAX_USE_4BIT=True
MINIMAX_USE_CACHE=True
MINIMAX_USE_KV_CACHE=True

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/counsel.log
