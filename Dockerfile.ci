FROM python:3.11-slim

# Set environment variables
ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    python3-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements-docker-clean.txt /tmp/requirements.txt

# Install Python dependencies with explicit upgrade of pip and debug output
RUN pip install --no-cache-dir --upgrade pip && \
    # Force uninstall langgraph if it exists
    pip uninstall -y langgraph || true && \
    # Install langgraph directly from PyPI with verbose output
    pip install --no-cache-dir --verbose langgraph==0.2.20 && \
    # Verify langgraph installation
    python -c "import langgraph; print(f'LangGraph version: {langgraph.__version__}')" && \
    # Install remaining requirements with verbose output
    pip install --no-cache-dir --verbose -r /tmp/requirements.txt && \
    # Force reinstall langgraph to ensure it's not overwritten
    pip install --no-cache-dir --force-reinstall --verbose langgraph==0.2.20 && \
    # Debug output
    echo "Installed packages:" && \
    pip list && \
    echo "Python path:" && \
    python -c "import sys; print('\n'.join(sys.path))" && \
    echo "Testing langgraph import:" && \
    python -c "from langgraph.graph import StateGraph, END; print('✅ LangGraph import successful')" && \
    # List all files in site-packages
    echo "Contents of site-packages:" && \
    ls -la /usr/local/lib/python3.11/site-packages/ && \
    echo "Contents of langgraph directory:" && \
    ls -la /usr/local/lib/python3.11/site-packages/langgraph*

# Copy application code
COPY . /app

# Add health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Create non-root user
RUN useradd --create-home --shell /bin/bash app && \
    chown -R app:app /app

USER app

# Verify imports again after user switch and show detailed debug info
RUN echo "Testing imports as app user:" && \
    python -c "import sys; print('Python path:'); print('\n'.join(sys.path))" && \
    python -c "import langgraph; print(f'LangGraph version: {langgraph.__version__}')" && \
    python -c "from langgraph.graph import StateGraph, END; print('✅ LangGraph import successful as app user')" && \
    python -c "import app.agents.counsel_agent; print('✅ Counsel agent import successful')" && \
    # Show permissions of site-packages
    ls -la /usr/local/lib/python3.11/site-packages/langgraph* || true

# Add a startup script to verify imports before running uvicorn
COPY <<'EOF' /app/start.sh
#!/bin/bash
echo "Verifying imports before starting server..."
python -c "import langgraph; print(f'LangGraph version: {langgraph.__version__}')"
python -c "from langgraph.graph import StateGraph, END"
python -c "import app.agents.counsel_agent"
echo "All imports verified successfully, starting server..."
exec uvicorn app.api.main:app --host 0.0.0.0 --port 8000
EOF

RUN chmod +x /app/start.sh

CMD ["/app/start.sh"]
