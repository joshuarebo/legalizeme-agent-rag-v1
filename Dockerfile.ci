FROM python:3.11-slim

# Reduce pip verbosity and avoid permission issues
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore

WORKDIR /app

# Install system dependencies needed for common AI and document libraries
RUN apt-get update && apt-get install -y \
    build-essential \
    python3-dev \
    libxml2-dev \
    libxslt1-dev \
    zlib1g-dev \
    libjpeg-dev \
    libffi-dev \
    libssl-dev \
    libopenblas-dev \
    libomp-dev \
    build-essential \
    git \
    curl \
    software-properties-common \
    poppler-utils \
    tesseract-ocr \
    libtesseract-dev \
    libmagic-dev \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libxml2 \
    libxslt1.1 \
    # Additional dependencies for Hunyuan and quantization
    cmake \
    ninja-build \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements files
COPY requirements-docker-clean.txt ./requirements.txt

# Upgrade pip and install dependencies with better error handling
RUN pip install --upgrade pip setuptools wheel && \
    # Install langgraph and its dependencies first
    pip install --no-cache-dir "langgraph>=0.2.20" && \
    # Then install the rest of the requirements
    pip install --no-cache-dir -r requirements.txt

# Copy the rest of the application code
COPY . .

EXPOSE 8000

# Add healthcheck
HEALTHCHECK --interval=5s --timeout=3s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "app.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
